# HTTP
PORT=1234
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_TEMP_DIR=
UPLOAD_MAX_FILE_SIZE_BYTES=20971520
UPLOAD_MODEL_MAX_FILE_SIZE_BYTES=20971520
UPLOAD_IMAGE_MAX_FILE_SIZE_BYTES=5242880

# Database: local development works without remote credentials.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Authentication
AUTH_SESSION_TTL_SECONDS=3600
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_LIMIT=10
AUTH_REGISTRATION_WINDOW_MS=3600000
AUTH_REGISTRATION_LIMIT=5
AUTH_PASSWORD_WINDOW_MS=3600000
AUTH_PASSWORD_LIMIT=5
OPENAI_RATE_LIMIT_WINDOW_MS=60000
OPENAI_RATE_LIMIT=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI Responses API. The application keeps store=false in code.
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=
OPENAI_GUIDE_MODEL=
OPENAI_CHAT_MODEL=gpt-4o-mini

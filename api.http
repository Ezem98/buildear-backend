@baseUrl = http://localhost:1234/api/v1
@token = reemplazar-con-access-token
@userId = 1
@modelId = 1
@conversationId = 1

# Registrar usuario
POST {{baseUrl}}/users HTTP/1.1
Content-Type: application/json

{
  "name": "Usuario",
  "surname": "Prueba",
  "username": "usuario_prueba",
  "email": "usuario_prueba@example.test",
  "password": "una-clave-segura",
  "experience_level": 1,
  "completed_profile": 1
}

###

# Iniciar sesión. Copiar data.access_token en @token.
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "usuario_prueba",
  "password": "una-clave-segura"
}

###

# Listar modelos para obtener @modelId y sus datos de generación.
GET {{baseUrl}}/models HTTP/1.1

###

# Generar y guardar una guía en user_models.
POST {{baseUrl}}/openai HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "model_id": {{modelId}},
  "modelName": "Pared de ladrillos",
  "modelCategory": 3,
  "modelSize": {
    "width": 300,
    "height": 240
  },
  "experienceLevel": 1
}

###

# Consultar la guía y el progreso persistidos.
GET {{baseUrl}}/userModels/{{userId}}/{{modelId}} HTTP/1.1
Authorization: Bearer {{token}}

###

# Actualizar el paso actual/completado. Reemplazar 1 por el id de user_models.
PATCH {{baseUrl}}/userModels/1 HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "completed": 0,
  "current_step": 2
}

###

# Iniciar un chat. La API crea la conversación y devuelve conversation_id.
POST {{baseUrl}}/openai/message HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "¿Cómo preparo la superficie antes de comenzar?"
}

###

# Continuar el chat usando el conversation_id de la respuesta anterior.
POST {{baseUrl}}/openai/message HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conversation_id": {{conversationId}},
  "message": "¿Qué elementos de protección personal necesito?"
}

###

# Consultar conversaciones y mensajes persistidos.
GET {{baseUrl}}/conversation/user/{{userId}} HTTP/1.1
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/conversationMessage/conversation/{{conversationId}} HTTP/1.1
Authorization: Bearer {{token}}

###

# Cerrar y revocar la sesión actual.
POST {{baseUrl}}/auth/logout HTTP/1.1
Authorization: Bearer {{token}}
